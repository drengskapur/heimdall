{
  "name": "heimdall",
  "version": "0.9.0",
  "description": "Heimdall — an installable, offline-first Progressive Web App port of Freelens, the open-source Kubernetes IDE (a Lens fork).",
  "keywords": [
    "kubernetes",
    "freelens",
    "lens",
    "kubernetes-ide",
    "pwa",
    "offline-first",
    "vite",
    "react",
    "hexagonal-architecture",
    "openapi"
  ],
  "homepage": "https://github.com/drengskapur/heimdall#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drengskapur/heimdall.git"
  },
  "bugs": {
    "url": "https://github.com/drengskapur/heimdall/issues"
  },
  "author": "Drengskapur",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev-spa.mjs",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "npm run codegen && vite build --config vite.config.ts",
    "start": "node server/api-server.mjs",
    "lint": "eslint . --ignore-pattern dist --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "codegen": "node scripts/generate-openapi-types.mjs",
    "coverage": "node scripts/enumerate-api-coverage.mjs",
    "coverage:md": "node scripts/enumerate-api-coverage.mjs --md > docs/design/api-coverage.md",
    "codegen:fetch-kube": "node scripts/fetch-kube-openapi.mjs",
    "prepare": "npm run codegen",
    "test": "npm run test:domain && npm run test:integration && npm run test:streaming && npm run test:statechart && npm run test:licenses && npm run test:sbom && npm run test:deadcode && npm run test:ui",
    "test:ui": "node --import tsx --test \"tests/ui/**/*.test.ts\"",
    "test:domain": "node --import tsx --test \"app/domain/**/*.test.ts\" \"app/application/**/*.test.ts\" \"app/infrastructure/**/*.test.ts\"",
    "test:integration": "node --import tsx --test \"tests/integration/**/*.test.ts\"",
    "test:streaming": "node --test tests/e2e/streaming.test.mjs",
    "test:statechart": "node --test tests/statechart-structure.test.mjs && node scripts/generate-statechart.mjs --check",
    "test:licenses": "node scripts/generate-third-party-notices.mjs --check",
    "test:sbom": "node scripts/generate-sbom.mjs --check",
    "test:deadcode": "knip",
    "test:all": "npm run test:domain && npm run test:integration && npm run test:streaming && npm run test:e2e:sim",
    "test:e2e:sim": "node scripts/run-e2e-sim.mjs",
    "test:e2e:spa": "node scripts/run-e2e-spa.mjs",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:a11y": "node scripts/a11y.mjs",
    "test:mutation": "stryker run",
    "fuzz": "node scripts/fuzz.mjs",
    "simulator": "node tests/e2e/kube-simulator.mjs",
    "statechart:generate": "node scripts/generate-statechart.mjs",
    "licenses:generate": "node scripts/generate-third-party-notices.mjs",
    "sbom:generate": "node scripts/generate-sbom.mjs",
    "gate:release": "node scripts/quality-gate.mjs",
    "companion": "node companion/server.mjs",
    "companion:dev": "node scripts/companion-dev.mjs",
    "dev:spa": "vite --config vite.config.ts",
    "dev:ui": "vite --config vite.config.ts --port 5199 --strictPort",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "check": "npm run format:check && npm run lint && npm run typecheck"
  },
  "dependencies": {
    "@blueprintjs/core": "^6.18.0",
    "@blueprintjs/icons": "^6.13.0",
    "@blueprintjs/select": "^6.3.4",
    "@blueprintjs/table": "^6.2.4",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "undici": "8.10.0",
    "ws": "^8.18.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@cyclonedx/cyclonedx-npm": "^6.0.1",
    "@eslint/js": "^9.39.5",
    "@jazzer.js/core": "^4.0.0",
    "@playwright/test": "^1.63.0",
    "@stryker-mutator/core": "^10.0.0",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "^4.13.0",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.6",
    "fast-check": "^4.9.0",
    "globals": "^17.12.0",
    "knip": "^6.34.0",
    "openapi-typescript": "^7.13.0",
    "swagger2openapi": "^7.0.8",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "8.2.2"
  },
  "overrides": {
    "qs": "6.15.3"
  }
}
