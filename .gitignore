# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.*

# Build output
/dist/
/out/

# Editor / OS
.DS_Store
.idea/
*.pem

# Logs
npm-debug.log*
yarn-debug.log*
.pnpm-debug.log*
/fidelity-*.log
/node-dev-*.log
/dev.log
/dev-out.log
/dev-err.log

# Env files (opt-in for committing if needed)
.env*

# TypeScript incremental build info
*.tsbuildinfo

# Test / coverage output
/coverage
/.cache/
/screenshots/
/test-results/
/playwright-report/
/.e2e/

# Mutation testing
/.stryker-tmp/
/reports/
stryker.log

# The converted OpenAPI is a build artifact: `npm run codegen` derives
# openapi-v*.json from the committed swagger-v*.json beside it, so a fresh clone
# needs no network. (This comment used to say the opposite — that the converted
# form was the committed one — which is backwards.) Re-vendor the raw swagger
# with `npm run codegen:fetch-kube`.
/openapi/kubernetes/openapi-*.json

# Generated from OpenAPI (source of truth: openapi/; regenerated by
# the `prepare` hook / `npm run codegen`)
/app/lib/generated/

# Fuzzing: compiled code under test, and the inputs a finding leaves behind.
.fuzz-build/
crash-*

# Local Claude Code settings: developer tooling, not project configuration.
.claude/

# Transient output of `npm run test:sbom`; the committed SBOM is sbom.cdx.json
sbom.cdx.check.json
